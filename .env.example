POSTGRES_DB=quizverse
POSTGRES_USER=quizverse
POSTGRES_PASSWORD=quizverse
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://quizverse:quizverse@db:5432/quizverse
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRES_SECONDS=2592000
JWT_TOKEN_LOCATION=headers,cookies
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_EXPOSE_TOKEN_IN_RESPONSE=false
AUTH_ENABLE_DEV_TOKEN_ENDPOINT=true
GOOGLE_OAUTH_CLIENT_ID=
EMAIL_SETTINGS_ENCRYPTION_KEY=
QUIZ_PUBLICATION_ENFORCED=true
OTP_EXPIRES_SECONDS=300
OTP_MIN_RESEND_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_INCLUDE_CODE_IN_RESPONSE=false
SERVICE_MAINTENANCE_MODE=false
SERVICE_MAINTENANCE_TITLE=メンテナンス情報はありません
SERVICE_MAINTENANCE_MESSAGE=現在メンテナンス予定はありません。
SERVICE_MAINTENANCE_SCHEDULED_UNTIL=
BACKEND_PORT=5000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:5000
VITE_API_PROXY_TARGET=http://backend:5000

# Vercel Production / Preview では以下を必ず安全な値へ置き換える
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<managed-postgres-host>:5432/<database>?sslmode=require
# SECRET_KEY=<long-random-secret>
# JWT_SECRET_KEY=<long-random-secret>
# JWT_COOKIE_SECURE=true
# JWT_COOKIE_SAMESITE=Lax
# AUTH_TRUSTED_ORIGINS=https://<your-project>.vercel.app
# AUTH_EXPOSE_TOKEN_IN_RESPONSE=false
# AUTH_ENABLE_DEV_TOKEN_ENDPOINT=false
# OTP_INCLUDE_CODE_IN_RESPONSE=false
# QUIZ_PUBLICATION_ENFORCED=true
